# Copy to mirl.env (git-ignored), edit for your deployment, then source it.
# Keep credentials in the referenced private file, never in this template.
export MIRL_CLUSTER_ROOT=/path/to/workspace
export MIRL_DATA_ROOT=/path/to/datasets
export MIRL_SCRATCH_ROOT=/path/to/scratch
export MIRL_PYENV=/path/to/conda/env
export MIRL_CONDA_SH=/path/to/conda/etc/profile.d/conda.sh
export SBATCH_ACCOUNT=your-project-account

export MIRL_WANDB_ENTITY=your-wandb-entity
export WANDB_EXPECTED_USERNAME=your-wandb-username
export WANDB_API_KEY_FILE="$MIRL_CLUSTER_ROOT/.wandb_key"

# OpenAI-compatible teacher endpoint; not needed for alignment/SFT/RL training.
export MIRL_OPENAI_BASE_URL=https://your-teacher-service.example/v1
export MIRL_OPENAI_KEY_FILE=/path/to/private/teacher-key

# Stage-1 alignment inputs.
export MIRL_ALIGN_DATA_ROOT="$MIRL_DATA_ROOT/trainedve_raw"
export MIRL_QWEN35_PATH=/path/to/qwen35-snapshot
export MIRL_SIGLIP2_PATH=/path/to/siglip2-snapshot

# Optional alternate-cluster configuration.
# export MIRL_ORCD_ROOT=/path/to/alternate-workspace
# export MIRL_ORCD_REPO=/path/to/alternate-checkout
# export MIRL_ORCD_ACCOUNT=your-project-account
# export MIRL_ORCD_PARTITION=your-gpu-partition
